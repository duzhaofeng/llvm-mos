  - { id: 32, class: _, preferred-register: '', flags: [  ] }
  - { id: 33, class: _, preferred-register: '', flags: [  ] }
  - { id: 34, class: ac, preferred-register: '', flags: [  ] }
  - { id: 35, class: _, preferred-register: '', flags: [  ] }
  - { id: 36, class: ac, preferred-register: '', flags: [  ] }
  - { id: 37, class: yc, preferred-register: '', flags: [  ] }
  - { id: 38, class: yc, preferred-register: '', flags: [  ] }
  - { id: 39, class: _, preferred-register: '', flags: [  ] }
  - { id: 40, class: _, preferred-register: '', flags: [  ] }
  - { id: 41, class: _, preferred-register: '', flags: [  ] }
  - { id: 42, class: imag16, preferred-register: '', flags: [  ] }
  - { id: 43, class: imag16, preferred-register: '', flags: [  ] }
  - { id: 44, class: imag16, preferred-register: '', flags: [  ] }
  - { id: 45, class: ac, preferred-register: '', flags: [  ] }
  - { id: 46, class: ac, preferred-register: '', flags: [  ] }
  - { id: 47, class: ac, preferred-register: '', flags: [  ] }
  - { id: 48, class: anyi8, preferred-register: '', flags: [  ] }
  - { id: 49, class: cc, preferred-register: '', flags: [  ] }
  - { id: 50, class: vc, preferred-register: '', flags: [  ] }
  - { id: 51, class: anyi8, preferred-register: '', flags: [  ] }
  - { id: 52, class: cc, preferred-register: '', flags: [  ] }
  - { id: 53, class: vc, preferred-register: '', flags: [  ] }
  - { id: 54, class: anyi8, preferred-register: '', flags: [  ] }
  - { id: 55, class: cc, preferred-register: '', flags: [  ] }
  - { id: 56, class: vc, preferred-register: '', flags: [  ] }
  - { id: 57, class: anyi8, preferred-register: '', flags: [  ] }
  - { id: 58, class: cc, preferred-register: '', flags: [  ] }
  - { id: 59, class: vc, preferred-register: '', flags: [  ] }
  - { id: 60, class: anyi8, preferred-register: '', flags: [  ] }
