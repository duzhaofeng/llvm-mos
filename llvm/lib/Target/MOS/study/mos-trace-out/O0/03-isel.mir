  - { id: 63, class: anyi8, preferred-register: '', flags: [  ] }
  - { id: 64, class: cc, preferred-register: '', flags: [  ] }
  - { id: 65, class: vc, preferred-register: '', flags: [  ] }
  - { id: 66, class: anyi8, preferred-register: '', flags: [  ] }
  - { id: 67, class: cc, preferred-register: '', flags: [  ] }
  - { id: 68, class: vc, preferred-register: '', flags: [  ] }
  - { id: 69, class: anyi8, preferred-register: '', flags: [  ] }
  - { id: 70, class: cc, preferred-register: '', flags: [  ] }
  - { id: 71, class: vc, preferred-register: '', flags: [  ] }
liveins:         []
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        false
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 4294967295
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
  savePoint:       ''
  restorePoint:    ''
fixedStack:      []
stack:
  - { id: 0, name: retval, type: default, offset: 0, size: 2, alignment: 1, 
      stack-id: default, callee-saved-register: '', callee-saved-restored: true, 
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
  - { id: 1, name: x.addr, type: default, offset: 0, size: 2, alignment: 1, 
      stack-id: default, callee-saved-register: '', callee-saved-restored: true, 
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.1.entry:
    successors: %bb.2(0x40000000), %bb.3(0x40000000)
    liveins: $a, $x
  
    %1:ac = COPY $a
    %2:ac = COPY $x
    %66:anyi8, %67:cc, %68:vc = AddrLostk %stack.1.x.addr, 0
    %69:anyi8, %70:cc, %71:vc = AddrHistk %stack.1.x.addr, 0, %67
    %4:imag16 = REG_SEQUENCE %66, %subreg.sublo, %69, %subreg.subhi
    %38:yc = LDImm 0
    STIndirIdx %1, %4, %38 :: (store (s8) into %ir.x.addr)
    %37:yc = LDImm 1
    STIndirIdx %2, %4, %37 :: (store (s8) into %ir.x.addr + 1)
    %34:ac = LDIndirIdx %4, %38 :: (dereferenceable load (s8) from %ir.x.addr)
    %36:ac = LDIndirIdx %4, %37 :: (dereferenceable load (s8) from %ir.x.addr + 1)
    CmpBrZeroMultiByte %bb.3, 1, %34, %36, implicit-def $c
    JMP %bb.2
  
  bb.2.if.then:
    successors: %bb.4(0x80000000)
  
    %25:yc = LDImm 0
    %54:anyi8, %55:cc, %56:vc = AddrLostk %stack.0.retval, 0
    %57:anyi8, %58:cc, %59:vc = AddrHistk %stack.0.retval, 0, %55
    %43:imag16 = REG_SEQUENCE %54, %subreg.sublo, %57, %subreg.subhi
    %45:ac = LDImm 1
    STIndirIdx %45, %43, %25 :: (store (s8) into %ir.retval)
    %24:yc = LDImm 1
    %47:ac = LDImm 0
    STIndirIdx %47, %43, %24 :: (store (s8) into %ir.retval + 1)
    JMP %bb.4
  
  bb.3.if.end:
    successors: %bb.4(0x80000000)
  
    %31:yc = LDImm 0
    %60:anyi8, %61:cc, %62:vc = AddrLostk %stack.0.retval, 0
    %63:anyi8, %64:cc, %65:vc = AddrHistk %stack.0.retval, 0, %61
    %44:imag16 = REG_SEQUENCE %60, %subreg.sublo, %63, %subreg.subhi
    %46:ac = LDImm 0
    STIndirIdx %46, %44, %31 :: (store (s8) into %ir.retval)
    %30:yc = LDImm 1
    STIndirIdx %46, %44, %30 :: (store (s8) into %ir.retval + 1)
  
  bb.4.return:
    %19:yc = LDImm 0
    %48:anyi8, %49:cc, %50:vc = AddrLostk %stack.0.retval, 0
    %51:anyi8, %52:cc, %53:vc = AddrHistk %stack.0.retval, 0, %49
    %42:imag16 = REG_SEQUENCE %48, %subreg.sublo, %51, %subreg.subhi
    %14:ac = LDIndirIdx %42, %19 :: (dereferenceable load (s8) from %ir.retval)
    %18:yc = LDImm 1
    %17:ac = LDIndirIdx %42, %18 :: (dereferenceable load (s8) from %ir.retval + 1)
    $a = COPY %14
    $x = COPY %17
    RTS implicit $a, implicit $x

...
